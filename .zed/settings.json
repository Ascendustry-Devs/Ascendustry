// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
    "prettier": {
        "allowed": false
    },
    "soft_wrap": "editor_width",
    "soft_wrap_indent": "extra_one",
    "format_on_save": "modifications_if_available",
    "file_scan_exclusions": [
        "./target/",
        "./Flamegraph/",
        ".opencode/",
        ".git/",
        "_apart/",
    ],
}
